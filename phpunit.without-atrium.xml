<?xml version="1.0" encoding="UTF-8"?>
<!--
    The package with refactor-circus/atrium absent. Run it through
    `composer test:without-atrium`, which points Pest's test directory at
    tests/WithoutAtrium so the main suite's tests/Pest.php is not booted.
    XML comments may not hold a double hyphen, so the option is not spelled
    out here.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    backupGlobals="false"
    bootstrap="tests/WithoutAtrium/bootstrap.php"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    executionOrder="random"
    failOnWarning="true"
    failOnRisky="true"
    failOnEmptyTestSuite="true"
    beStrictAboutOutputDuringTests="true"
    cacheDirectory=".phpunit.cache"
    backupStaticProperties="false"
>
    <testsuites>
        <testsuite name="WithoutAtrium">
            <directory>tests/WithoutAtrium</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
